{
  "name": "@bravecat/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "咪游记 API v1 请求/响应类型、zod schema、存档文档类型与统一错误码",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
