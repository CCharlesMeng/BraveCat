# 服务监听
PORT=3000
HOST=0.0.0.0

# Postgres（对应 docker-compose.yml 的默认值）
DATABASE_URL=postgres://bravecat:bravecat@localhost:5432/bravecat

# 经济占位校验：每现实小时可积累的小鱼干上限 + 新账号初始额度
ECONOMY_MAX_EARN_PER_HOUR=600
ECONOMY_INITIAL_EARN_ALLOWANCE=100

# —— 以下仅 docker-compose.prod.yml（生产部署）读取，本地 dev 不需要 ——
# Postgres 密码（compose 同时注入 postgres 容器与 api 的 DATABASE_URL）
#POSTGRES_PASSWORD=
# 逗号分隔的完整 origin 列表（如 https://app.example.com），生产必填
#CORS_ALLOWED_ORIGINS=
# 镜像 tag（默认 latest），发布时可固定为 git sha
#API_IMAGE_TAG=
