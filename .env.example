# 资源发布到阿里云 OSS（scripts/publish-assets-oss.mjs，S3 兼容 API）。
# 复制为 .env 后填写；.env 已被 git 忽略，不要提交真实密钥。
# 全部留空时 `npm run assets:publish` 自动进入 dry-run：完整走收集、
# 版权门禁、清单生成并打印上传计划，但不真正上传。

# OSS 的 S3 兼容 endpoint 与区域 ID（换云只需改这里）。
ASSET_PUBLISH_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ASSET_PUBLISH_REGION=oss-cn-hangzhou

# 目标 bucket 与访问密钥（建议用只授予该 bucket 写权限的 RAM 子账号）。
ASSET_PUBLISH_BUCKET=
ASSET_PUBLISH_ACCESS_KEY_ID=
ASSET_PUBLISH_SECRET_ACCESS_KEY=

# 可选对象键前缀，如 prod（清单与资产都放在该前缀下）。
ASSET_PUBLISH_PREFIX=

# 绑定到 bucket 的公网 CDN 域名，如 https://assets.example.com。
# 记录进远程清单；也是下面 VITE_ASSET_BASE_URL 应取的值。
ASSET_CDN_BASE_URL=

# apps/web 构建期注入 AssetResolver 的 CDN base（不带尾部斜杠）。
# 留空 = 相对根路径加载，与 CDN 引入前的行为完全一致。
VITE_ASSET_BASE_URL=
