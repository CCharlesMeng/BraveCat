{
  "name": "bravecat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-production-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "assets:archive": "node scripts/archive-assets.mjs --expansion-plan docs/art/landmark-expansion-v2.json --expansion-plan docs/art/landmark-expansion-v3.json --visual-approval docs/art/reviews/landmarks/visual-approval.v2.json --composite-approval docs/art/reviews/landmarks/composites/approval.v2.json --rights-review docs/art/reviews/landmarks/rights-review-v3-addendum.md --rights-decision docs/art/reviews/landmarks/rights-decision.v2.json --archive-output docs/art/archive/asset-archive.v2.json --archive-readme-output docs/art/archive/README.v2.md --review-index-output docs/art/candidates/landmarks/review-index.archive.v3.md",
    "assets:check": "npm run assets:archive -- --check",
    "assets:archive:v1": "node scripts/archive-assets.mjs",
    "assets:check:v1": "node scripts/archive-assets.mjs --check",
    "assets:integrate-landmarks": "node scripts/integrate-landmarks.mjs",
    "assets:check-landmark-candidates": "node scripts/integrate-landmarks.mjs --check",
    "assets:promote-landmarks": "node scripts/promote-landmarks.mjs --candidate-manifest docs/art/candidates/landmarks/manifest.candidates.v3.json --candidate-qa docs/art/candidates/landmarks/qa-report.v3.json --visual-approval docs/art/reviews/landmarks/visual-approval.v2.json --rights-review docs/art/reviews/landmarks/rights-review-v3-addendum.md --rights-decision docs/art/reviews/landmarks/rights-decision.v2.json --composite-manifest docs/art/reviews/landmarks/composites/manifest.v2.json --composite-approval docs/art/reviews/landmarks/composites/approval.v2.json --archive docs/art/archive/asset-archive.v2.json --production-manifest docs/art/production/landmarks/manifest.v2.json --review-index docs/art/candidates/landmarks/review-index.v3.md",
    "assets:check-landmarks": "npm run assets:promote-landmarks -- --check",
    "assets:promote-landmarks:v1": "node scripts/promote-landmarks.mjs --allow-extra-runtime-files --generated-catalog docs/art/production/landmarks/landmarkCatalog.v1.generated.ts",
    "assets:check-landmarks:v1": "node scripts/promote-landmarks.mjs --allow-extra-runtime-files --generated-catalog docs/art/production/landmarks/landmarkCatalog.v1.generated.ts --check",
    "assets:composite-qa": "node scripts/build-composite-qa.mjs --archive docs/art/archive/asset-archive.v2.json --output-root docs/art/reviews/landmarks/composites --output-manifest docs/art/reviews/landmarks/composites/manifest.v2.json --approval docs/art/reviews/landmarks/composites/approval.v2.json",
    "assets:composite-check": "npm run assets:composite-qa -- --check",
    "assets:composite-qa:v1": "node scripts/build-composite-qa.mjs",
    "assets:composite-check:v1": "node scripts/build-composite-qa.mjs --check"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.2",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.3",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dexie": "^4.4.4"
  }
}
