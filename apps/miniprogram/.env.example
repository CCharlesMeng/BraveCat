# Taro 环境变量（https://docs.taro.zone/docs/env-mode-config）。
# 以 TARO_APP_ 为前缀的变量会注入到 process.env。

# 正式小程序 AppID；开发者工具里用测试号可留空（project.config.json 为 touristappid）。
# TARO_APP_ID=

# 运行时游戏美术资产的 base URL（不带尾部斜杠）。
# 主包不含任何游戏图片（2MB 上限），全部经 AssetResolver 前缀此值加载：
# - 生产：与 scripts/publish-assets-oss.mjs 的 ASSET_CDN_BASE_URL 取同一个值。
# - 开发：指向本地静态服务器，例如在仓库根目录执行
#     npx serve apps/web/public -l 8787
#   然后取 http://127.0.0.1:8787（开发者工具需勾选「不校验合法域名」）。
TARO_APP_ASSET_BASE_URL=
