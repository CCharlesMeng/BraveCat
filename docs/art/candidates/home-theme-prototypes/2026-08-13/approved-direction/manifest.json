  "approvedOn": "2026-08-13",
  "approval": "visual-direction-approved",
  "runtimeEligible": false,
  "source": "cursor-session-candidate",
  "blockers": {
    "CONCEPT_FLATTENED": "The complete concept bakes exterior, HomeFinish, furniture, and dynamic display content into one image and cannot be used as separated runtime layers.",
    "REVIEW_BOARD_NON_PRODUCTION": "The review board contains a paper background and composite layout and is not production alpha or a directly sliceable asset.",
    "HOMEFORM_GEOMETRY_UNFROZEN": "A and B lack independent high-resolution 16:9 HomeForm controls, while F still needs final 16:9 geometry annotation.",
    "RUNTIME_CONTRACT_MISSING": "Apertures, support surfaces, sockets, slot quads, anchors, hit areas, exclusion zones, z-bands, and foreground occlusion assets are not frozen or complete.",
    "UI_DIRECTION_ONLY": "The UI image approves visual direction only; it does not authorize implementation and is not runtime UI art.",
    "SOURCE_ASPECT_RATIO": "The archived source is 1024x1536 (2:3), not the 1200x1600 (3:4) production contract.",
    "ALPHA_MASK_MISSING": "The source has no alpha; black apertures or paper backgrounds are baked review surfaces, not production masks or transparent layers.",
    "SHAPE_REVIEW_NON_PRODUCTION": "The shape review approves silhouette, material, and color only; its paper background and contact shadow cannot be cut into runtime art.",
    "SOCKET_REGISTRATION_UNVERIFIED": "Exact sockets, placement coordinates, support and exclusion geometry, occlusion splits, and pixel registration remain outside this approval.",
    "COMPOSITE_COORDINATES_UNAPPROVED": "The assembled room approves overall pairing and visual balance only, not exact coordinates, runtime layer boundaries, or registration.",
    "GENERATED_UI_TEXT_NON_AUTHORITATIVE": "Generated glyphs, labels, and microcopy in the review image are not authoritative; formal wording remains defined by the UI spec.",
    "UI_RUNTIME_NOT_IMPLEMENTED": "The approved hierarchy and real-art adaptation direction do not authorize or provide a runtime UI implementation.",
    "UI_INTERACTION_QA_MISSING": "Preview, confirmation, rollback, object selection, compatibility filtering, and responsive interaction flows have not passed runtime QA.",
    "CAT_ITEM_NOT_ALPHA": "The cat-item shape review has a baked paper background and no alpha, so it is not a runtime base or foreground layer.",
    "CAT_ITEM_RUNTIME_CONTRACT_MISSING": "Cat-item sockets, support surfaces, interaction targets, exclusion zones, foreground occlusion, and pixel registration are not production-ready.",
    "USAGE_BOARD_NOT_RUNTIME_EVIDENCE": "The Minho usage board approves visual pose, scale, and occlusion direction only; it is not runtime composition, animation-path, or frame-by-frame occlusion evidence.",
    "FULL_CANVAS_REGISTRATION_MISSING": "The intrinsic alpha candidate has not been registered into a theme full-canvas coordinate system.",
    "CAT_ITEM_OCCLUSION_MISSING": "Foreground occlusion and cat-body intersection layers have not been produced from a shared registered master.",
    "CAT_ITEM_SOCKET_MISSING": "Support, interaction, activity-area, entrance, exit, and target sockets or polygons are not frozen.",
    "CAT_POSE_QA_MISSING": "The candidate has not passed project-cat Pose registration, animation-path, or frame-by-frame occlusion QA.",
    "EVIDENCE_NOT_RUNTIME_ASSET": "The QA report or contact sheet is supporting evidence only and must not be treated as a runtime image asset."
  },
